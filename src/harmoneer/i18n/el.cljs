(ns harmoneer.i18n.el
  (:require [clojure.string :as str]
            [harmoneer.theory :as t]
            [harmoneer.harmony :as h]))

;; Phrases avoid noun cases where they can: voices go in parentheses or after a colon, so their
;; names stay in the nominative. Don't use ";" as a separator: it's the Greek question mark.

;; ---------------------------------------------------------------- formatting

(defn- note [loc n] (t/note-name n (:names loc)))
(defn- pc [loc n] (t/pc-name n (:names loc)))

(defn- key-name [loc {:keys [tonic mode]}]
  (str (t/tonic-name tonic (:names loc)) (if (= mode :major) " μείζονα" " ελάσσονα")))

(def ^:private voice-names {:s "σοπράνο" :a "άλτο" :t "τενόρος" :b "μπάσος"})

(defn- voice [v] (voice-names v))
(defn- Voice [v] (str/capitalize (voice-names v)))
(defn- two [u l] (str "(" (voice u) " – " (voice l) ")"))

(def ^:private roles {0 "θεμέλιος" 1 "τρίτη" 2 "πέμπτη"})

(def ^:private q-words
  {:P "καθαρή" :M "μεγάλη" :m "μικρή" :A "αυξημένη" :d "ελαττωμένη"
   :AA "δις αυξημένη" :dd "δις ελαττωμένη"})

(defn- iv-long [{:keys [num q]}]
  (cond (> num 8) "πάνω από οκτάβα"
        (= num 8) (str (q-words q) " οκτάβα")
        :else (str (q-words q) " " num "η")))

(defn- chord [key c] (str (h/numeral key c) (h/inversion-figure (:inv c))))

(defn- perfects [p] (if (zero? p) "οκτάβες" "πέμπτες"))

